class Solution {
    public String maximizeSumOfSquares(int num, int sum) {
        // Step 1: Guard clause for impossible sums
        if (sum > 9L * num) {
            return "";
        }
        
        StringBuilder sb = new StringBuilder();
        
        // Step 2: Append as many 9s as possible
        int numNines = sum / 9;
        int remainder = sum % 9;
        
        for (int i = 0; i < numNines; i++) {
            sb.append('9');
        }
        
        // Step 3: Append remainder if room permits
        if (sb.length() < num && remainder > 0) {
            sb.append(remainder);
        }
        
        // Step 4: Pad with trailing zeros
        while (sb.length() < num) {
            sb.append('0');
        }
        
        return sb.toString();
    }
}
